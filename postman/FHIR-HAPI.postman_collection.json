{
  "info": {
    "_postman_id": "6b92f1b2-96c9-41af-9cb3-0b51c77c960a",
    "name": "FHIR-HAPI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "HAPI FHIR R4 requests for the metadata-driven Fabric ingestion project."
  },
  "item": [
    {
      "name": "1 - Metadata (CapabilityStatement)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"resourceType is CapabilityStatement\", () => pm.expect(pm.response.json().resourceType).to.eql(\"CapabilityStatement\"));",
              "pm.test(\"rest[0].resource is a non-empty array\", () => {",
              "  const r = pm.response.json().rest[0].resource;",
              "  pm.expect(r).to.be.an(\"array\").that.is.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/fhir+json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metadata",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "metadata"
          ],
          "query": []
        },
        "description": "API metadata source: lists resources, search params and interactions."
      }
    },
    {
      "name": "2 - Patient list (paged)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"resourceType is Bundle\", () => pm.expect(pm.response.json().resourceType).to.eql(\"Bundle\"));",
              "pm.test(\"entry is an array\", () => pm.expect(pm.response.json().entry).to.be.an(\"array\"));",
              "pm.test(\"next link present\", () => {",
              "  const next = (pm.response.json().link || []).find(l => l.relation === \"next\");",
              "  pm.expect(next, \"no next link\").to.not.be.undefined;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/fhir+json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/Patient?_count=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "Patient"
          ],
          "query": [
            {
              "key": "_count",
              "value": "50"
            }
          ]
        },
        "description": "Inspect entry[], link[] and total. Copy the next link to test paging."
      }
    },
    {
      "name": "3 - Patient incremental (_lastUpdated)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"resourceType is Bundle\", () => pm.expect(pm.response.json().resourceType).to.eql(\"Bundle\"));",
              "pm.test(\"entry is an array\", () => pm.expect(pm.response.json().entry).to.be.an(\"array\"));",
              "pm.test(\"entries sorted by lastUpdated ascending\", () => {",
              "  const d = (pm.response.json().entry || []).map(e => e.resource.meta.lastUpdated);",
              "  const sorted = [...d].sort();",
              "  pm.expect(d).to.eql(sorted);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/fhir+json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/Patient?_lastUpdated=gt2026-11-01&_sort=_lastUpdated&_count=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "Patient"
          ],
          "query": [
            {
              "key": "_lastUpdated",
              "value": "gt2026-11-01"
            },
            {
              "key": "_sort",
              "value": "_lastUpdated"
            },
            {
              "key": "_count",
              "value": "50"
            }
          ]
        },
        "description": "Incremental pattern used by the pipeline: server-side filter on _lastUpdated."
      }
    },
    {
      "name": "4 - Patient count (_summary=count)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"resourceType is Bundle\", () => pm.expect(pm.response.json().resourceType).to.eql(\"Bundle\"));",
              "pm.test(\"total is a number\", () => pm.expect(pm.response.json().total).to.be.a(\"number\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/fhir+json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/Patient?_summary=count",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "Patient"
          ],
          "query": [
            {
              "key": "_summary",
              "value": "count"
            }
          ]
        },
        "description": "Row count used for reconciliation."
      }
    }
  ]
}